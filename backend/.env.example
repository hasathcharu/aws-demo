# MySQL connection. These are the defaults the server falls back to, so you can
# leave them alone for a stock local MySQL with an empty root password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Test123
DB_NAME=travel_journal

# S3 photo storage. Both are required - the server refuses to start without them.
S3_BUCKET=my-travel-journal-bucket
AWS_REGION=us-east-1

# AWS credentials are NOT read from here. The AWS SDK's default chain picks them
# up from `aws configure` (~/.aws/credentials), AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in your shell, or an instance role.

# Port the API listens on.
PORT=8080
