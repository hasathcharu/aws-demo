# Base URL of the Go service.
#
# There is deliberately no NEXT_PUBLIC_ prefix: this value is read only inside
# lib/api.ts, which is marked "server-only", so it never reaches the browser
# bundle. In AWS this points at the private-subnet address of the Go service
# (an internal load balancer DNS name, or service discovery name), for example:
#
#   API_URL=http://internal-journal-api-1234567890.us-east-1.elb.amazonaws.com
#
# For local development both processes run on your machine:
API_URL=http://localhost:8080
